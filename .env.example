# Tất cả biến dưới đây đều tuỳ chọn — app phải chạy, build, và test được
# ngay cả khi không có file .env nào hoặc không biến nào được set. Thiếu
# nhóm Supabase thì các seam trong src/lib/supabase trả null; thiếu
# GOOGLE_GENERATIVE_AI_API_KEY thì AI Stylist dùng deterministic fallback.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
